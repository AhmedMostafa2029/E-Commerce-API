{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "StoreDbConnection": "Server=.;Database=StoreDb;Trusted_Connection=True;TrustServerCertificate=True",
    "RedisConnection": "localhost",
    "IdentityConnection": "Server=.;Database=StoreIdentityDb;Trusted_Connection=True;TrustServerCertificate=True"

  },
  "UrlSettings": {
    "BaseUrl": "https://localhost:7244"
  },
  "JWT": {
    "SecretKey": "YOUR_JWT_SECRET_KEY",
    "Issuer": "https://localhost:7244",
    "Audience": "https://localhost:7244",
    "ExpirationByMinutes": 60
  },
  "Stripe": {
    "SecretKey": "YOUR_STRIPE_SECRET_KEY",
    "DefaultCurrency": "USD"
  }

}
